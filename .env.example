# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/pj37"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="PJ37 Digital"

# Payment (fill in production)
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
WECHAT_APP_ID=""
WECHAT_MCH_ID=""
WECHAT_API_KEY=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="PJ37 Digital <noreply@pj37.com>"

# Card Key Encryption (must be exactly 32 characters)
CARD_KEY_SECRET="your-encryption-key-32-chars-here"

# Cron jobs
CRON_SECRET="your-cron-secret-here"

# Logging
LOG_LEVEL="info"

# Docker Compose overrides (only used by docker-compose.yml)
POSTGRES_PASSWORD="change-me-in-production"
HTTP_PORT=80
DB_PORT=5432
REDIS_PORT=6379
